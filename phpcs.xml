<?xml version="1.0"?>
<ruleset name="Exports and Reports">
    <description>Exports and Reports WordPress Coding Standards</description>

    <!-- Scan all files in directory -->
    <file>./exports-and-reports.php</file>
    <file>./api.php</file>
    <file>./uninstall.php</file>
    <file>./includes</file>
    <file>./wp-admin-ui</file>

    <!-- Scan only PHP files -->
    <arg name="extensions" value="php"/>

    <!-- Show colors in console -->
    <arg value="-colors"/>

    <!-- Show sniff codes in all reports -->
    <arg value="s"/>

    <!-- Include the WordPress-Extra standard. -->
    <rule ref="WordPress-Extra">
        <!-- Exclude any rules here -->
        <exclude name="Universal.Operators.DisallowShortTernary"/>
    </rule>

    <!-- Let's also check that everything is properly documented. -->
<!--    <rule ref="WordPress-Docs"/>-->

    <!-- Every request read is unslashed and sanitised (part of the full WordPress standard, not of WordPress-Extra). -->
    <rule ref="WordPress.Security.ValidatedSanitizedInput"/>

    <!-- The plugin's own capabilities. -->
    <rule ref="WordPress.WP.Capabilities">
        <properties>
            <property name="custom_capabilities" type="array">
                <element value="exports_reports_full_access"/>
                <element value="exports_reports_settings"/>
                <element value="exports_reports_view"/>
            </property>
        </properties>
    </rule>

    <!-- Add in some extra rules from other standards. -->
    <rule ref="Generic.CodeAnalysis.UnusedFunctionParameter"/>
    <rule ref="Generic.Commenting.Todo"/>

    <config name="minimum_supported_wp_version" value="6.0"/>
</ruleset>