<?xml version="1.0"?>
<ruleset name="PHP Compatibility">
	<config name="testVersion" value="7.4-"/>

	<!-- The PDF export class runs on PHP 8.2 and later only (the library's floor); .phpcs.compat-pdf.xml checks it. -->
	<exclude-pattern>*/includes/class-exports-reports-admin-ui-export-pdf\.php$</exclude-pattern>
	<exclude-pattern>*/\.github/*</exclude-pattern>
	<exclude-pattern>*/\.wordpress-org/*</exclude-pattern>
	<exclude-pattern>*/tests/*</exclude-pattern>
	<exclude-pattern>*/vendor/*</exclude-pattern>

	<arg name="extensions" value="php"/>
	<arg name="colors"/>
	<arg name="report" value="full,summary"/>

	<rule ref="PHPCompatibilityWP"/>
</ruleset>