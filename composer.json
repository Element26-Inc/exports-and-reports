{
  "name": "sc0ttkclark/exports-and-reports",
  "type": "wordpress-plugin",
  "description": "Define custom exports / reports for users, based off of any custom MySQL SELECT query you define.",
  "license": "GPL-2.0-or-later",
  "require": {
    "composer/installers": "^2.2",
    "mk-j/php_xlsxwriter": "^0.39",
    "php": ">=7.2",
    "tecnickcom/tc-lib-pdf": "^8.82",
    "tecnickcom/tcpdf": "^6.11.4"
  },
  "require-dev": {
    "dealerdirect/phpcodesniffer-composer-installer": "^1.0.0",
    "phpcompatibility/phpcompatibility-wp": "^2.1",
    "phpstan/extension-installer": "^1.4",
    "phpstan/phpstan": "^2.0",
    "phpstan/phpstan-deprecation-rules": "^2.0",
    "szepeviktor/phpstan-wordpress": "^2.0",
    "wp-cli/wp-cli": "2.*",
    "wp-coding-standards/wpcs": "^3.0.1"
  },
  "minimum-stability": "stable",
  "prefer-stable": true,
  "suggest": {
    "wp-cli/wp-cli": "Enables access to Pods CLI commands."
  },
  "scripts": {
    "strauss": [
      "test -f ./bin/strauss.phar || curl -sSL -o bin/strauss.phar https://github.com/BrianHenryIE/strauss/releases/download/0.31.1/strauss.phar",
      "@php -r \"if ( '17dc2baf27b9a3f52834e3db729c8365d8915a80e37a087d253cf705387aa887' !== hash_file( 'sha256', 'bin/strauss.phar' ) ) { fwrite( STDERR, 'bin/strauss.phar is not Strauss 0.31.1; delete it and run the script again' . PHP_EOL ); exit( 1 ); }\"",
      "@php bin/strauss.phar"
    ],
    "post-install-cmd": [
      "@strauss"
    ],
    "post-update-cmd": [
      "@strauss"
    ]
  },
  "extra": {
    "installer-name": "exports-and-reports",
    "strauss": {
      "target_directory": "vendor/vendor-prefixed",
      "namespace_prefix": "ExportsReports\\Prefixed",
      "classmap_prefix": "ExportsReports__Prefixed__",
      "constant_prefix": "EXPORTS_REPORTS_PREFIXED_",
      "function_prefix": "exportreports_prefixed_",
      "packages": [
        "mk-j/php_xlsxwriter",
        "tecnickcom/tc-lib-pdf",
        "tecnickcom/tcpdf"
      ],
      "exclude_from_prefix": {
        "file_patterns": [
          "/tcpdf\\/include\\/barcodes\\//",
          "/tcpdf\\/tcpdf_autoconfig\\.php$/",
          "/tcpdf\\/config\\//"
        ]
      },
      "exclude_from_copy": {
        "file_patterns": [
          "/examples/",
          "/testbench/",
          "/example(-cli)?\\.php$/",
          "/README\\.md$/",
          "/composer\\.(json|lock)$/",
          "/\\.gitignore$/",
          "/tcpdf\\/fonts\\/(?!(?:helvetica|courier|times|symbol|zapfdingbats)[a-z]*\\.php$)/",
          "/tcpdf\\/tools\\//",
          "/tcpdf\\/include\\/barcodes\\//"
        ]
      },
      "delete_vendor_files": true
    }
  },
  "config": {
    "allow-plugins": {
      "composer/installers": true,
      "dealerdirect/phpcodesniffer-composer-installer": true,
      "kylekatarnls/update-helper": true,
      "phpstan/extension-installer": true
    },
    "platform": {
      "php": "8.2"
    },
    "platform-check": false,
    "github-protocols": [
      "https"
    ]
  }
}
