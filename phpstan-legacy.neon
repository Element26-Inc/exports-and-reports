# Analysis below PHP 8.2, down to the plugin's floor of 7.4: the PDF export class and the prefixed PDF
# library are written for 8.2 and are the only files the plugin loads there, so they are left out.
includes:
	- phpstan.neon
parameters:
	phpVersion: 70400
	scanDirectories!:
		- wp-admin-ui
		- vendor/vendor-prefixed/mk-j
	excludePaths:
		- wp-admin-ui/includes/class-exports-reports-admin-ui-export-pdf.php
